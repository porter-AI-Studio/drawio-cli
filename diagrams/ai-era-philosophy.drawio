        <!-- 筋斗雲 → 十萬八千里（一躍）-->
        <mxCell id="e3" value="一 躍"
          style="curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#f9a825;strokeWidth=3;endArrow=block;endFill=1;startArrow=none;fontSize=14;fontStyle=1;fontColor=#f57f00;align=center;"
          edge="1" source="cloud_outer" target="dest_bg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ====== 底部哲學引言 ====== -->
        <mxCell id="bottom_q" value="「工具越強大，越需要清晰的人文意志來駕馭它。技術是手段，人是目的——這是三十年來，我從未改變的設計信仰。」"
          style="text;html=1;fontSize=11;fontStyle=2;align=center;fillColor=#fffff8;strokeColor=#d6b656;rounded=1;spacingTop=4;spacingBottom=4;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="548" width="1000" height="38" as="geometry" />
        </mxCell>

      </root>

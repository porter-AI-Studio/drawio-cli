          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AI謎境 → 筋斗雲 -->
        <mxCell id="e2" value=""
          style="curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.04;entryY=0.67;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;"

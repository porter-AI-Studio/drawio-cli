        <mxCell id="e1" value=""
          style="curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.04;entryY=0.33;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;"

<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="draw-cli" version="1.0.0">
  <diagram name="AI世代登雲之道" id="philosophy-001">
    <mxGraphModel dx="1200" dy="650" grid="0" page="0" pageWidth="1654" pageHeight="1169" background="#FAFAFA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ====== 標題 ====== -->
        <mxCell id="main_title" value="AI 世代 · 登雲之道"
          style="text;html=1;fontSize=26;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#2c3e50;"
          vertex="1" parent="1">
          <mxGeometry x="340" y="12" width="480" height="42" as="geometry" />
        </mxCell>
        <mxCell id="main_sub" value="無論你此刻仍在荊棘叢中摸索爬行，抑或已如夢似幻地深陷 AI 謎境——讓我帶你登上筋斗雲，如悟空一躍，十萬八千里"
          style="text;html=1;fontSize=11;fontStyle=2;align=center;fillColor=none;strokeColor=none;fontColor=#aaaaaa;"
          vertex="1" parent="1">
          <mxGeometry x="150" y="54" width="860" height="22" as="geometry" />
        </mxCell>

        <!-- ====== 左上：荊棘叢 ====== -->
        <mxCell id="thorn_bg" value=""
          style="rounded=1;fillColor=#fff5f5;strokeColor=#e8a0a0;dashed=1;strokeWidth=1.5;"
          vertex="1" parent="1">
          <mxGeometry x="18" y="88" width="298" height="188" as="geometry" />
        </mxCell>
        <mxCell id="thorn_label" value="⚡  荊棘叢"
          style="text;html=1;fontSize=11;fontColor=#b85450;fontStyle=1;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="96" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="thorn_node" value="仍在荊棘叢中&#xa;摸索爬行"
